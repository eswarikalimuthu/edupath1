# ---------------------------------------------------------------------------
# PARSERS: Recommendation, Roadmap, Schedule
# ---------------------------------------------------------------------------
def parse_recommendation(text: str) -> dict:
    """Splits recommendation text into the 5 CareerCompass sections."""

    sections = {
        "careers": "",
        "courses": "",
        "scholarships": "",
        "schemes": "",
        "next_steps": ""
    }

    patterns = [
        ("careers", r"Suggested\s+Career\s+Pathways"),
        ("scholarships", r"Eligible\s+Scholarships"),
        ("courses", r"Recommended\s+Institutions\s*&?\s*Courses"),
        ("schemes", r"Welfare\s*&?\s*Govt\s+Schemes"),
        ("next_steps", r"Next\s+Steps\s*&?\s*Action\s+Points"),
    ]

    positions = []

    for key, pattern in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            positions.append((key, match.start(), match.end()))

    positions.sort(key=lambda x: x[1])

    if not positions:
        return sections

    for i, (key, start, end) in enumerate(positions):
        next_start = (
            positions[i + 1][1]
            if i + 1 < len(positions)
            else len(text)
        )

    return sections


def render_section_card(section_text: str, card_title: str, icon: str):
    """Formats AI section text into clean HTML cards."""

    if not section_text.strip() or "no relevant documents found" in section_text.lower():
        st.info(f"No {card_title.lower()} available in context.")
        return

    # Clean up malformed markdown artifacts
    text = re.sub(r"```(?:html|markdown)?", "", section_text, flags=re.IGNORECASE)
    text = text.replace("```", "").strip()
    text = text.replace("### **", "### ").replace("**###", "###")
    text = re.sub(r"\\+\*", "*", text) # replace double-escaped asterisks

    # Remove unwanted closing/opening wrapper divs from AI output
    text = re.sub(r"</?div[^>]*>", "", text, flags=re.IGNORECASE)

    # Convert HTML paragraph content into plain text
    text = re.sub(r"<p[^>]*>", "", text, flags=re.IGNORECASE)
    text = re.sub(r"</p>", "", text, flags=re.IGNORECASE)
    text = re.sub(r"<span[^>]*>", "", text, flags=re.IGNORECASE)
    text = re.sub(r"</span>", "", text, flags=re.IGNORECASE)

    lines = text.split("\n")
    items = []

    for line in lines:
        line = line.strip()

        if not line:
            continue

        # Ignore useless markdown headings
        if line in ["###", "##", "#"]:
            continue

        # Remove list markers
        line = re.sub(r"^[-*•]\s+", "", line)
        line = re.sub(r"^\d+\.\s+", "", line)

        # Find citations
        citations = re.findall(
            r"\((?:source|citation):\s*([^)]+)\)",
            line,
            re.IGNORECASE
        )

        clean_text = re.sub(
            r"\((?:source|citation):\s*[^)]+\)",
            "",
            line,
            flags=re.IGNORECASE
        ).strip()

        # Find linked resources
        linked = []

        linked_match = re.search(
            r"\[(?:linked|resources):\s*([^]]+)\]",
            clean_text,
            re.IGNORECASE
        )

        if linked_match:
            linked = [
                r.strip()
                for r in linked_match.group(1).split(",")
            ]

            clean_text = re.sub(
                r"\[(?:linked|resources):\s*[^]]+\]",
                "",
                clean_text,
                flags=re.IGNORECASE
            ).strip()

        # Remove remaining HTML tags
        clean_text = re.sub(r"<[^>]+>", "", clean_text).strip()

        if clean_text:
            items.append({
                "text": clean_text,
                "citations": citations,
                "linked": linked
            })

    if not items:
        st.markdown(text, unsafe_allow_html=True)
        return

    html = f"""
    <div class="edu-card">
        <div class="edu-card-header">
            <span class="edu-card-icon">{icon}</span>
            <span class="edu-card-title">{card_title}</span>
        </div>
        <div class="edu-card-body">
    """

    for item in items:

        citation_html = ""

        for cit in item["citations"]:
            citation_html += (
                f'<span class="cit-tag">📄 {cit}</span>'
            )

        for link in item["linked"]:
            citation_html += (
                f'<span class="link-tag">🔗 {link}</span>'
            )

        # Convert **bold** into HTML
        item_text = re.sub(
            r"\*\*(.*?)\*\*",
            r"<strong>\1</strong>",
            item["text"]
        )

        html += f"""
        <div class="edu-item">
            <p class="edu-item-text">{item_text}</p>
            <div class="edu-item-meta">
                {citation_html}
            </div>
        </div>
        """

    html += """
        </div>
    </div>
    """

    st.markdown(html, unsafe_allow_html=True)

def parse_pathway_to_milestones(pathway_text: str) -> list[dict]:
    """Parses Pathway Planner text into structured milestones with Action, Why it matters, and Skills."""
    phases_patterns = [
        ("Immediate (0-1 month)", r"([#]+\s*[-*•]?\s*Immediate[^\n]*)"),
        ("Short-term (1-6 months)", r"([#]+\s*[-*•]?\s*Short-term[^\n]*)"),
        ("Medium-term (6-18 months)", r"([#]+\s*[-*•]?\s*Medium-term[^\n]*)"),
        ("Long-term (18+ months)", r"([#]+\s*[-*•]?\s*Long-term[^\n]*)"),
    ]
    
    positions = []
    for name, pattern in phases_patterns:
        match = re.search(pattern, pathway_text, re.IGNORECASE)
        if match:
            positions.append((name, match.start(), match.end()))
            
    positions.sort(key=lambda x: x[1])
    
    milestones = []
    if not positions:
        return milestones
        
    for i in range(len(positions)):
        name, start, end = positions[i]
        next_start = positions[i+1][1] if i + 1 < len(positions) else len(pathway_text)
        phase_content = pathway_text[end:next_start].strip()
        
        lines = phase_content.split("\n")
        items = []
        for line in lines:
            line = line.strip()
            if not line:
                continue
            if line.startswith("- ") or line.startswith("* ") or re.match(r"^\d+\.\s+", line):
                line = re.sub(r"^[-*\d\.\s]+", "", line).strip()
                
            # Skip if it is not a bullet-point item
            if not line or line.lower().startswith("most urgent"):
                continue
                
            citations = re.findall(r"\((?:source|citation):\s*([^)]+)\)", line, re.IGNORECASE)
            clean_text = re.sub(r"\((?:source|citation):\s*[^)]+\)", "", line, re.IGNORECASE).strip()
            
            linked_resources = []
            linked_match = re.search(r"\[(?:linked|resources):\s*([^]]+)\]", clean_text, re.IGNORECASE)
            if linked_match:
                linked_resources = [r.strip() for r in linked_match.group(1).split(",")]
                clean_text = re.sub(r"\[(?:linked|resources):\s*[^]]+\]", "", clean_text, re.IGNORECASE).strip()
                
            # Try to split structured text: Action | Why it matters | Skills/Opportunity
            action = clean_text
            why_it_matters = ""
            skills_opportunity = ""
            
            if "|" in clean_text:
                parts = clean_text.split("|")
                for part in parts:
                    part_stripped = part.strip()
                    if part_stripped.lower().startswith("action:"):
                        action = part_stripped[7:].strip()
                    elif part_stripped.lower().startswith("why it matters:"):
                        why_it_matters = part_stripped[15:].strip()
                    elif part_stripped.lower().startswith("skills/opportunity:"):
                        skills_opportunity = part_stripped[19:].strip()
                    elif part_stripped.lower().startswith("skills:"):
                        skills_opportunity = part_stripped[7:].strip()
                    else:
                        if not why_it_matters and not part_stripped.lower().startswith("action:"):
                            why_it_matters = part_stripped
            
            action = action.replace("### **", "").replace("**", "").replace("\\*\\*", "").strip()
            why_it_matters = why_it_matters.replace("### **", "").replace("**", "").replace("\\*\\*", "").strip()
            skills_opportunity = skills_opportunity.replace("### **", "").replace("**", "").replace("\\*\\*", "").strip()
            
            items.append({
                "id": str(uuid.uuid4())[:8],
                "action": action,
                "text": clean_text,
                "why_it_matters": why_it_matters,
                "skills_opportunity": skills_opportunity,
                "citations": citations,
                "linked_resources": linked_resources,
                "completed": False
            })
            
        milestones.append({
            "phase": name,
            "items": items
        })
        
    return milestones


def parse_schedule_table(schedule_text: str) -> list[dict]:
    """Parses markdown table of schedule from schedule agent."""
    lines = schedule_text.split("\n")
    items = []
    for line in lines:
        line = line.strip()
        if "|" not in line or "Month" in line or "---" in line:
            continue
            
        parts = [p.strip() for p in line.split("|")]
        if parts[0] == "":
            parts = parts[1:]
        if parts and parts[-1] == "":
            parts = parts[:-1]
            
        if len(parts) >= 3:
            month = parts[0]
            action = parts[1]
            priority = parts[2]
            
            citations = re.findall(r"\((?:source|citation):\s*([^)]+)\)", action, re.IGNORECASE)
            clean_action = re.sub(r"\((?:source|citation):\s*[^)]+\)", "", action, re.IGNORECASE).strip()
            
            linked_resources = []
            linked_match = re.search(r"\[(?:linked|resources):\s*([^]]+)\]", clean_action, re.IGNORECASE)
            if linked_match:
                linked_resources = [r.strip() for r in linked_match.group(1).split(",")]
                clean_action = re.sub(r"\[(?:linked|resources):\s*[^]]+\]", "", clean_action, re.IGNORECASE).strip()
                
            items.append({
                "id": str(uuid.uuid4())[:8],
                "month": month,
                "action": clean_action,
                "priority": priority,
                "citations": citations,
                "linked_resources": linked_resources,
                "completed": False
            })
    return items


def render_gantt_chart(schedule_items: list[dict]):
    """Renders a custom HTML Gantt table for schedule items."""
    if not schedule_items:
        return ""
        
    months = []
    for item in schedule_items:
        if item["month"] not in months:
            months.append(item["month"])
            
    if not months:
        return ""
        
    html = """
    <div style="overflow-x: auto; width: 100%; border: 1px solid #E2E8F0; border-radius: 12px; background: white; padding: 16px; margin-bottom: 24px;">
        <table style="width: 100%; border-collapse: collapse; font-family: 'Inter', sans-serif; font-size: 0.85rem;">
            <thead>
                <tr style="border-bottom: 2px solid #E2E8F0; background-color: #F8FAFC;">
                    <th style="text-align: left; padding: 12px; color: #1E3A8A; font-weight: 600;">Action Item</th>
    """
    for m in months:
        html += f'<th style="text-align: center; padding: 12px; color: #1E3A8A; font-weight: 600; min-width: 100px;">{m}</th>'
    html += """
                </tr>
            </thead>
            <tbody>
    """
    
    for item in schedule_items:
        if item["priority"].lower() == "high":
            bar_color = "#FEE2E2"
            bar_border = "#FCA5A5"
            bar_text = "#991B1B"
        elif item["priority"].lower() == "medium":
            bar_color = "#FEF3C7"
            bar_border = "#FDE68A"
            bar_text = "#92400E"
        else:
            bar_color = "#D1FAE5"
            bar_border = "#6EE7B7"
            bar_text = "#065F46"
            
        if item["completed"]:
            bar_color = "#E2E8F0"
            bar_border = "#CBD5E1"
            bar_text = "#475569"
            
        html += f"""
        <tr style="border-bottom: 1px solid #F1F5F9;">
            <td style="padding: 12px; text-align: left; font-weight: 500; color: #334155;">
                {item["action"]}
                {" ✅" if item["completed"] else ""}
            </td>
        """
        for m in months:
            if item["month"] == m:
                html += f"""
                <td style="padding: 6px; text-align: center;">
                    <div style="background-color: {bar_color}; border: 1px solid {bar_border}; color: {bar_text}; padding: 6px 10px; border-radius: 6px; font-weight: 600; font-size: 0.72rem; text-transform: uppercase;">
                        {item["priority"]}
                    </div>
                </td>
                """
            else:
                html += '<td style="padding: 6px; text-align: center; color: #CBD5E1;">•</td>'
        html += "</tr>"
        
    html += """
            </tbody>
        </table>
    </div>
    """
    return html


def get_motivational_message(profile: dict) -> str:
    """Returns a tailored motivational quote based on the student's education stage/year."""
    year = str(profile.get("current_year", "")).lower()
    stage = str(profile.get("education_stage", "")).lower()
    
    if "3rd" in year or "third" in year:
        return "💡 **Opportunity Awaits:** You already have a foundation. Now turn your skills into projects, experience, and opportunities."
    elif "final" in year or "4th" in year or "fourth" in year:
        return "🚀 **Action Time:** Your next opportunity starts with the work you do today."
    elif "1st" in year or "first" in year:
        return "🌱 **Adapt & Explore:** Adapting to college takes time. Focus on programming fundamentals, mini-projects, and foundational skills."
    elif "2nd" in year or "second" in year:
        return "✨ **Consistency Is Key:** Small skills built consistently become big opportunities. Start working on small projects."
    elif "12th" in year or "school" in stage:
        return "🧭 **Your Journey Begins:** Your career doesn't need to be figured out today. Just take the next right step."
    else:
        return "✨ **Take the Next Step:** Your roadmap is a direction, not a deadline."


# ---------------------------------------------------------------------------
# LOGIN GATEWAY (Centered Authentication Card)
# ---------------------------------------------------------------------------
if "username" not in st.session_state:
    col_left, col_center, col_right = st.columns([1, 1.8, 1])
    with col_center:
        st.markdown("""
        <div class="auth-container">
            <div class="auth-header">
                <div class="auth-logo">🎓</div>
                <h1 class="auth-title">CareerCompass AI</h1>
                <p class="auth-subtitle">AI Career & Education Advisor for Indian Students</p>
            </div>
        </div>
        """, unsafe_allow_html=True)
        
        login_tab, signup_tab = st.tabs(["🔑 Login", "🆕 Sign Up"])
        
        with login_tab:
            st.markdown("<p style='color: #64748B; font-size: 0.9rem; text-align: center; margin-bottom: 16px;'>Welcome back! Enter your details to access your roadmap.</p>", unsafe_allow_html=True)
            login_user = st.text_input("Username", key="login_user")
            login_pass = st.text_input("Password", type="password", key="login_pass")
            if st.button("Login", use_container_width=True, type="primary"):
                if auth.verify_user(login_user, login_pass):
                    st.session_state["username"] = login_user
                    st.rerun()
                else:
                    st.error("Incorrect username or password.")
                    
        with signup_tab:
            st.markdown("<p style='color: #64748B; font-size: 0.9rem; text-align: center; margin-bottom: 16px;'>Create a new student account to save your progress.</p>", unsafe_allow_html=True)
            new_user = st.text_input("Choose a username", key="signup_user")
            new_pass = st.text_input("Choose a password", type="password", key="signup_pass")
            if st.button("Sign Up", use_container_width=True, type="primary"):
                if not new_user.strip() or not new_pass.strip():
                    st.warning("Username and password can't be empty.")
                elif auth.create_user(new_user, new_pass):
                    st.success("Account created! Please log in from the Login tab.")
                else:
                    st.error("That username is already taken.")
                    
    st.stop()

